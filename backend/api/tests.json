{
  "tests": [
    {
      "name": "Получить список дел",
      "method": "GET",
      "path": "/?table=cases",
      "expectedStatus": 200
    },
    {
      "name": "Получить настройки",
      "method": "GET",
      "path": "/?table=settings",
      "expectedStatus": 200
    },
    {
      "name": "Неизвестная таблица",
      "method": "GET",
      "path": "/?table=hacker",
      "expectedStatus": 400
    },
    {
      "name": "Поиск по базе",
      "method": "GET",
      "path": "/?action=search&q=test",
      "expectedStatus": 200
    },
    {
      "name": "Авторизация с неверными данными",
      "method": "POST",
      "path": "/?action=auth",
      "body": {"login": "nope", "password": "nope"},
      "expectedStatus": 401
    }
  ]
}